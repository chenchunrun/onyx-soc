# Copy this file to env.security-platform and fill in the values needed by the
# Onyx security platform customization layer.
#
# Placeholder / example values such as replace-me, your-company, example.com,
# and mock-api-key-for-testing are intended only for templates and local demos.
# The security platform workbench and acceptance verification will flag them as
# deployment issues until they are replaced with environment-specific values.
#
# Usage example:
#   cp env.security-platform.template env.security-platform
#   docker compose \
#     -f docker-compose.yml \
#     -f docker-compose.security-platform.override.yml \
#     up -d


################################################################################
## SECURITY PLATFORM BOOTSTRAP
################################################################################

# Base URL used by the bootstrap / verification scripts.
# Use the host-facing URL when running the scripts on the host machine.
ONYX_URL=http://localhost:8080

# Bootstrap admin credentials.
ONYX_EMAIL=security-admin@onyx.local
ONYX_PASSWORD=admin123

# PostgreSQL password used by persona/RBAC scripts for direct DB operations.
POSTGRES_PASSWORD=password

# High-level deployment profile:
# - live: real threat-intel refresh + real tool endpoints
# - demo: local threat-intel corpus + mock tool endpoints
SECURITY_PLATFORM_DEPLOYMENT_PROFILE=live


################################################################################
## OPTIONAL SECURITY TOOL INTEGRATIONS
################################################################################

# Used by the send_security_alert tool.
# SECURITY_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...

# Used by the create_security_ticket tool.
# SECURITY_TICKET_API_URL=https://your-company.atlassian.net/rest/api/3
# SECURITY_TICKET_API_KEY=replace-me

# Used by the threat_intel_lookup tool.
# THREAT_INTEL_API_URL=https://www.virustotal.com/api/v3
# THREAT_INTEL_API_KEY=replace-me

# Used by the search_security_alerts tool.
# SECURITY_SIEM_API_URL=https://siem.example.com/api/v1
# SECURITY_SIEM_API_KEY=replace-me

# Used by the isolate_endpoint_host tool.
# SECURITY_EDR_API_URL=https://edr.example.com/api/v1
# SECURITY_EDR_API_KEY=replace-me

# Used by the lookup_asset_context tool.
# SECURITY_ASSET_API_URL=https://cmdb.example.com/api/v1
# SECURITY_ASSET_API_KEY=replace-me

# Security tools profile:
# - live: real webhook / ticket / threat-intel endpoints
# - mock: local mock tool server
# SECURITY_TOOLS_PROFILE=mock
#
# Used when SECURITY_TOOLS_PROFILE=mock
# SECURITY_TOOLS_MOCK_API_KEY is still treated as a placeholder/example value
# by runtime checks; replace it before any environment that should pass final
# acceptance verification.
#
# If Onyx runs in Docker and the mock server runs on the host, do not use
# localhost here. Containers must use host.docker.internal to reach the host.
# SECURITY_TOOLS_MOCK_SERVER_URL=http://host.docker.internal:9999
# SECURITY_TOOLS_MOCK_API_KEY=mock-api-key-for-testing

# Optional limit used by scheduled threat-intel sync jobs.
# THREAT_INTEL_SYNC_LIMIT=20

# Platform secret used for encrypted database fields. Required for any
# production-like environment that should pass final acceptance verification.
# ENCRYPTION_KEY_SECRET=replace-me

# Threat-intel source profile:
# - live: refresh upstream sources before syncing local files
# - mock: use only the local curated feed corpus
# THREAT_INTEL_SOURCE_PROFILE=mock


################################################################################
## OPTIONAL PLATFORM SETTINGS
################################################################################

# Uncomment if you want the bootstrap scripts to use a non-default Postgres host.
# POSTGRES_HOST=relational_db

# Core auth secret should also be injected from your real environment rather
# than committed to tracked config files.
# USER_AUTH_SECRET=replace-me

# Uncomment if your deployment is behind an external domain.
# WEB_DOMAIN=https://onyx.example.com
